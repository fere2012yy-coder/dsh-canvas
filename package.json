{
  "name": "dsh-canvas",
  "version": "0.1.0",
  "description": "DSH web plugin: a Canvas tool tab in the native right sidebar guide.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node tests/harness-interactions.mjs",
    "test:phase4": "node tests/canvas-features.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "react-dom": "^18.3.1"
  }
}
